amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local lintSteps = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    batch = true
  }
  ["cargo-fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["cargo-clippy"] {
    glob = List("**/*.rs")
    check = "cargo clippy --all-targets --all-features -- -D warnings"
    fix = "cargo clippy --fix --all-targets --all-features --allow-dirty -- -D warnings"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...lintSteps
    }
  }
  ["check"] {
    steps {
      ...lintSteps
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...lintSteps
    }
  }
}
